{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "api/**/*",
    "scripts/**/*.ts",
    "src/modules/ey/schema.ts",
    "src/modules/ey/imathAzotaParser.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "public",
    "src/modules/ey/TeacherDashboard.tsx"
  ]
}